# ── Multi-Agent CI System — Environment Variables ──────────────────────────────
#
# 1. Copy this file to .env:
#       cp .env.example .env
#
# 2. Fill in your OpenAI API key below.
#
# 3. Get an API key at:
#       https://platform.openai.com/api-keys
#    (Requires a funded account — $5 credit is more than enough)
# ──────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=your_openai_api_key_here
